#!/usr/bin/python3
import json
import locale
import subprocess
from gi.repository import Gtk

HOST = "/usr/lib/local-wps-editing/native-host"
ZH = (locale.getlocale()[0] or "").lower().startswith("zh")

TEXT = {
    "title": "本地 WPS 编辑设置" if ZH else "Local WPS Editing Setup",
    "configure": "配置" if ZH else "Configure",
    "recheck": "重新检查" if ZH else "Recheck",
    "deactivate": "停用此账户" if ZH else "Deactivate account",
    "export": "导出诊断" if ZH else "Export diagnostics",
}


class SetupWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title=TEXT["title"])
        self.set_default_size(520, 280)
        self.set_border_width(18)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.add(box)
        title = Gtk.Label()
        title.set_markup(f"<b>{TEXT['title']}</b>")
        title.set_xalign(0)
        box.pack_start(title, False, False, 0)
        self.status = Gtk.Label(label="")
        self.status.set_xalign(0)
        self.status.set_line_wrap(True)
        box.pack_start(self.status, True, True, 0)
        actions = Gtk.ButtonBox(spacing=8)
        actions.set_layout(Gtk.ButtonBoxStyle.START)
        box.pack_start(actions, False, False, 0)
        for label, command in ((TEXT["configure"], "setup"), (TEXT["recheck"], "doctor"), (TEXT["export"], "export-diagnostics"), (TEXT["deactivate"], "unregister")):
            button = Gtk.Button(label=label)
            button.connect("clicked", self.run_command, command)
            actions.add(button)
        self.run_command(None, "doctor")

    def run_command(self, _button, command):
        try:
            completed = subprocess.run([HOST, command, "--json"], check=False, text=True, capture_output=True)
            result = json.loads(completed.stdout or "{}")
            self.status.set_text(result.get("message") or result.get("state") or completed.stderr.strip())
        except (OSError, ValueError) as error:
            self.status.set_text(str(error))


window = SetupWindow()
window.connect("destroy", Gtk.main_quit)
window.show_all()
Gtk.main()
