{
  "manifest_version": 3,
  "name": "Local WPS Editing",
  "version": "1.0.0",
  "description": "Open server-managed DOCX documents in local WPS and submit verified versions.",
  "key": "",
  "permissions": ["activeTab", "alarms", "nativeMessaging", "notifications", "storage"],
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["sdk.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_start" }
  ],
  "background": { "service_worker": "service-worker.js" },
  "action": { "default_title": "Local WPS Editing", "default_popup": "popup.html" }
}
