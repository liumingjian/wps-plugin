{
  "manifest_version": 3,
  "name": "Local WPS Editing Demo",
  "version": "0.1.0",
  "description": "Relays versioned Editing Task control messages to the local agent.",
  "key": "",
  "host_permissions": [
    "http://127.0.0.1:4317/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:4317/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "background": {
    "service_worker": "service-worker.js"
  }
}
