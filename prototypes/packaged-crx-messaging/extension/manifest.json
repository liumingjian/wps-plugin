{
  "manifest_version": 3,
  "name": "WPS Editing Packaged CRX Prototype",
  "version": "0.1.0",
  "description": "PROTOTYPE: verifies a packaged page bridge, Native Messaging lifetime, and desktop notifications.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "notifications"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "service-worker.js"
  }
}
