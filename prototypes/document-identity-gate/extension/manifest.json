{
  "manifest_version": 3,
  "name": "Document Identity Gate (PROTOTYPE)",
  "version": "0.0.1",
  "description": "Disposable target-machine prototype for the production Document Identity Gate.",
  "key": "",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["intercept.js"],
      "run_at": "document_start"
    }
  ]
}
