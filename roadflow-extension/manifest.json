{
  "manifest_version": 3,
  "name": "RoadFlow WPS Editor",
  "version": "1.0.0",
  "description": "Open configured RoadFlow Documents in the packaged WPS editor.",
  "key": "",
  "permissions": ["storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["zip-core.min.js", "source-identity.js", "content.js"],
    "run_at": "document_start"
  }],
  "web_accessible_resources": [{
    "resources": ["editor.html"],
    "matches": ["http://*/*", "https://*/*"]
  }],
  "action": { "default_title": "RoadFlow WPS readiness", "default_popup": "readiness.html" },
  "options_page": "options.html",
  "icons": { "16": "icon.png", "48": "icon.png", "128": "icon.png" }
}
